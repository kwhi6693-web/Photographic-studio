# 复制为 engine/.env 并填写。.env 已被 .gitignore 排除，不会进入仓库。
# 换模型只改这里，代码不用动。

# 谁来读片、写导演单：openai | gemini | replay
STUDIO_VISION=openai
# 谁来画 G：openai | gemini | replay | none（none = 不用 G，只走 N 直出）
STUDIO_IMAGE=openai

# ---- API 密钥（留空即可，等开通后再填）----
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- 模型名（可选；不填用默认）----
# OPENAI_VISION_MODEL=gpt-5.1
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# GEMINI_VISION_MODEL=gemini-3-flash
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# ---- 成本估算（美元/次，用于评测汇总；按账单实际填写）----
# STUDIO_PRICE_IMAGE=0.08
# STUDIO_PRICE_VISION=0.01

# 每张最多调用几次 G
STUDIO_G_MAX=2
